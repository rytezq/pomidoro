<Window x:Class="pomidoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pomidoro"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox Name="Timer"
                Grid.Row="0"
                Margin="10"
                 Padding="20"
                 IsReadOnly="True"
                 Text="25:00:00"
                 TextAlignment="Center"
                 FontSize="30"
                 BorderThickness="2"
                 BorderBrush="Purple"
                 FontWeight="Bold"/>
        <TextBlock Name="StatusText"
                   Grid.Row="1"
                   Margin="10"
                   FontSize="16"
                   TextAlignment="Center"
                   Text="Готов к работе"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="StartB"
                    Content="Старт" 
                    Height="54" 
                    Width="144"
                    Background="Purple"
                    Foreground="White"
                    Click="Start_Click"/>
            <Button x:Name="ResetB"
                    Content="Сброс" 
                    Height="54" 
                    Width="144"
                    Background="PaleVioletRed"
                    Foreground="Azure"
                    Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>
